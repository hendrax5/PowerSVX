{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Query rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(powersvx_queries_total[1m]))",
          "legendFormat": "qps",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Cache hit ratio (fresh+stale)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "(rate(powersvx_cache_hits_total[1m]) + rate(powersvx_cache_stale_hits_total[1m])) / clamp_min(rate(powersvx_cache_hits_total[1m]) + rate(powersvx_cache_stale_hits_total[1m]) + rate(powersvx_cache_misses_total[1m]), 1e-9)",
          "legendFormat": "hit+stale",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Resolve inflight (vs Unbound reqlist)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "powersvx_resolve_inflight",
          "legendFormat": "inflight",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Latency p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(powersvx_query_duration_seconds_bucket[1m])))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(powersvx_query_duration_seconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Path QPS (cache / recursive / fallback)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (path) (rate(powersvx_query_duration_by_path_seconds_count[1m]))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Admit rejects / rate limit / RPZ",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(powersvx_admit_rejected_total[1m])",
          "legendFormat": "admit_rejected",
          "refId": "A"
        },
        {
          "expr": "rate(powersvx_rate_limited_total[1m])",
          "legendFormat": "ratelimit",
          "refId": "B"
        },
        {
          "expr": "rate(powersvx_rpz_blocked_total[1m])",
          "legendFormat": "rpz",
          "refId": "C"
        }
      ]
    },
    {
      "title": "Queries by status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum by (status) (rate(powersvx_queries_total[1m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Cache stale + prefetch",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "rate(powersvx_cache_stale_hits_total[1m])",
          "legendFormat": "stale_hits",
          "refId": "A"
        },
        {
          "expr": "rate(powersvx_cache_prefetch_total[1m])",
          "legendFormat": "prefetch",
          "refId": "B"
        }
      ]
    },
    {
      "title": "RSS / goroutines",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "powersvx_process_rss_bytes / 1024 / 1024",
          "legendFormat": "rss_mb",
          "refId": "A"
        },
        {
          "expr": "powersvx_goroutines",
          "legendFormat": "goroutines",
          "refId": "B"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["powersvx", "dns", "unbound-compare"],
  "timezone": "browser",
  "title": "PowerSVX DNS",
  "uid": "powersvx-dns",
  "version": 2
}
