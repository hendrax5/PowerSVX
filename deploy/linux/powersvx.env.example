# Copy to /etc/powersvx/powersvx.env and chmod 600.
# Referenced by systemd EnvironmentFile= and TOML ${VAR} expansion.

# Required
PG_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
API_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

# Optional RBAC (uncomment matching [[api.tokens]] in powersvx.toml)
# API_TOKEN_RO=CHANGE_ME_READONLY_TOKEN

# Timezone for logs
TZ=Asia/Jakarta
