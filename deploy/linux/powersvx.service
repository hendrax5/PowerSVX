[Unit]
Description=PowerSVX DNS server
Documentation=https://github.com/powersvx/powersvx
After=network-online.target postgresql.service
Wants=network-online.target
# Uncomment if Postgres is on the same host and managed by systemd:
# Requires=postgresql.service

[Service]
Type=simple
User=powersvx
Group=powersvx
WorkingDirectory=/var/lib/powersvx
EnvironmentFile=-/etc/powersvx/powersvx.env
ExecStart=/usr/local/bin/powersvx \
  --config /etc/powersvx/powersvx.toml \
  --data-dir /var/lib/powersvx
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

# Bind privileged ports (53/443/853) without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Hardening
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/powersvx /var/log/powersvx
ReadOnlyPaths=/etc/powersvx /usr/share/PowerSVX

LimitNOFILE=65535
LimitNPROC=4096

# Optional: journal only (JSON logs go to stdout)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=powersvx

[Install]
WantedBy=multi-user.target
