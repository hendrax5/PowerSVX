# Copy to .env next to docker-compose.yml (never commit real secrets).

PG_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
API_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

# UI login (http://HOST:5380/login):
#   username = admin
#   password = value of ADMIN_PASSWORD below
# API_TOKEN is for Bearer scripts only — it is NOT the UI password.
# On each container start, admin password is synced from this value.
ADMIN_PASSWORD=CHANGE_ME_ADMIN_UI_PASSWORD

# Optional
# SESSION_SECRET=
# API_TOKEN_RO=
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=CHANGE_ME
# TZ=Asia/Jakarta
# POWERSVX_IMAGE_TAG=latest
# WATCHTOWER_SCHEDULE=0 15 3 * * *
# Private GHCR pull (GitHub PAT with read:packages scope):
# GHCR_USER=hendrax5
# GHCR_TOKEN=
# DOCKER_CONFIG_DIR=/root/.docker
